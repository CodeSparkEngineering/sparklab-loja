# ─────────────────────────────────────────────────────────────
# SparkLab — variáveis de ambiente
# Copia este ficheiro para .env.local (dev) e configura AS MESMAS na
# Vercel (Project → Settings → Environment Variables) para produção.
# NUNCA comitar segredos — o .env.local está no .gitignore.
# (Placeholders abaixo NÃO são chaves reais — substitui pelos teus valores.)
# ─────────────────────────────────────────────────────────────

# ── Stripe (pagamentos) ──────────────────────────────────────
# Chave secreta do servidor.
# TESTE: dashboard.stripe.com/test/apikeys  (prefixo sk_test_…)
# LIVE : dashboard.stripe.com/apikeys       (prefixo sk_live_… — usar em produção)
STRIPE_SECRET_KEY=COLA_AQUI_A_CHAVE_SECRETA

# Segredo do webhook (prefixo whsec_…).
# Stripe → Developers → Webhooks → Add endpoint:
#   URL:    https://www.sparklab3d.pt/api/stripe-webhook
#   Evento: checkout.session.completed
# Sem isto, os emails pós-compra e o registo de encomendas NÃO disparam.
STRIPE_WEBHOOK_SECRET=COLA_AQUI_O_SIGNING_SECRET

# ── Emails de encomenda (Resend — https://resend.com) ────────
# Conta gratuita (chave com prefixo re_…).
# Para boa entrega, verifica o domínio sparklab3d.pt no Resend.
RESEND_API_KEY=COLA_AQUI_A_API_KEY_DO_RESEND

# Onde TU recebes o aviso de cada nova encomenda:
ORDER_EMAIL_TO=encomendas@sparklab3d.pt

# (Opcional) Remetente. Por omissão: "SparkLab <onboarding@resend.dev>".
# Em produção, usa um endereço do teu domínio já verificado no Resend:
# ORDER_EMAIL_FROM=SparkLab <encomendas@sparklab3d.pt>
